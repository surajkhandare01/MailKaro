{
  "manifest_version": 3,
  "name": "MailKaro - AI Email Assistant",
  "version": "1.0.0",
  "description": "Generate smart email replies directly inside Gmail powered by Gemini AI",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://mailkaro.onrender.com/*",
    "https://mail.google.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://mailkaro.vercel.app/*",
      "http://localhost:5173/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}