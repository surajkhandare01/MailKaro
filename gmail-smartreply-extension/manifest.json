{
  "manifest_version": 3,
  "name": "MailKaro - AI Email Writer",
  "version": "1.0",
  "description": "AI Email Writer & Smart Reply for Gmail supporting English, Hindi, and Marathi.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:5173/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["authSync.js"],
      "run_at": "document_idle"
    }
  ]
}